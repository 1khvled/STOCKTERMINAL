# StockerAI - Personal Terminal .env.example
# Copy to .env and fill your keys. No hardcoded secrets in repo.

# --- Core LLM (at least one) ---
GROQ_API_KEY=your_groq_key_here
# GROQ_API_KEY_2=second_key_optional
# Groq primary - VERIFIED LIVE 2026-09-08 (qwen/llama retired on these keys).
# Check live ids any time: keep this file's default or set GROQ_MODEL in .env
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MAX_TOKENS=6000
# GROQ_TEMPERATURE=0.35
# GROQ_REASONING_EFFORT=default   # low|medium|default|high|none
# GROQ_REASONING_FORMAT=hidden    # hidden|parsed

OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# OPENROUTER_FALLBACK_MODEL=
# OPENROUTER_TEMPERATURE=0.25
# OPENROUTER_TIMEOUT=60

# Optional Gemini / Anthropic / NVIDIA / OpenCode
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
# NVIDIA_API_KEY=
# OPENCODE_API_KEY=
# OPENCODE_MODEL=muse-spark-1.3-contributor-free
# OPENCODE_REASONING_EFFORT=medium   # medium|high
# OPENCODE_TIMEOUT=90

# --- Market Data (all optional, fallback to yfinance) ---
# FINNHUB_API_KEY=
# FMP_API_KEY=
# TIINGO_API_KEY=
# ALPHA_VANTAGE_API_KEY=

# --- SEC (use a REAL email you own - SEC throttles example.com agents) ---
SEC_USER_AGENT=you@example.com

# --- Notion (optional) ---
# NOTION_TOKEN=
# NOTION_PAGE_ID=

# --- Flask ---
# FLASK_SECRET_KEY=optional_long_random_hex

# --- Subscriptions / licensing (all optional) ---
# With none of these set the terminal runs on the FREE tier: no key, no crash.
# STOCKER_LICENSE_SECRET=shared_hmac_secret   # signs entitlement files / offline keys
# ADMIN_TOKEN=operator_console_token          # enables /admin (unset = disabled)
# BILLING_PROVIDER=manual                     # manual | webhook | none
# BILLING_WEBHOOK_SECRET=checkout_secret      # verifies signed checkout webhooks
# STOCKER_WEBHOOK_TOLERANCE=300               # webhook replay window (seconds)
# STOCKER_ENTITLEMENT_URL=https://control.example.com   # remote key validation
# STOCKER_ENTITLEMENT_API_TOKEN=optional_token            # guards /api/entitlement/verify
# STOCKER_ENTITLEMENT_FILE=output/.entitlement.json       # signed offline entitlement
# STOCKER_ACCOUNTS_DB=output/accounts.db                  # accounts database
# STOCKER_GRACE_DAYS=14                                   # offline grace period
# STOCKER_MACHINE_ID=                                     # override the machine fingerprint
# STOCKER_CHECKOUT_URL=https://buy.example.com/pro       # hosted checkout link

